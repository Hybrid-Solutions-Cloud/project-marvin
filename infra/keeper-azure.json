      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppEnvironmentName'))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 80,
            "transport": "auto"
          },
          "secrets": "[concat(createArray(createObject('name', 'database-url', 'value', variables('databaseUrl')), createObject('name', 'better-auth-secret', 'value', parameters('betterAuthSecret')), createObject('name', 'encryption-key', 'value', parameters('encryptionKey')), createObject('name', 'microsoft-client-id', 'value', parameters('microsoftClientId')), createObject('name', 'microsoft-client-secret', 'value', parameters('microsoftClientSecret'))), if(variables('useGoogle'), createArray(createObject('name', 'google-client-id', 'value', parameters('googleClientId')), createObject('name', 'google-client-secret', 'value', parameters('googleClientSecret'))), createArray()))]"
        },
        "template": {
          "containers": [
            {
              "name": "keeper",
              "image": "[parameters('containerImage')]",
              "env": "[concat(createArray(createObject('name', 'DATABASE_URL', 'secretRef', 'database-url'), createObject('name', 'REDIS_URL', 'value', 'redis://localhost:6379'), createObject('name', 'WORKER_JOB_QUEUE_ENABLED', 'value', 'true'), createObject('name', 'BETTER_AUTH_URL', 'value', parameters('betterAuthUrl')), createObject('name', 'BETTER_AUTH_SECRET', 'secretRef', 'better-auth-secret'), createObject('name', 'ENCRYPTION_KEY', 'secretRef', 'encryption-key'), createObject('name', 'TRUSTED_ORIGINS', 'value', parameters('trustedOrigins')), createObject('name', 'MICROSOFT_CLIENT_ID', 'secretRef', 'microsoft-client-id'), createObject('name', 'MICROSOFT_CLIENT_SECRET', 'secretRef', 'microsoft-client-secret')), if(variables('useGoogle'), createArray(createObject('name', 'GOOGLE_CLIENT_ID', 'secretRef', 'google-client-id'), createObject('name', 'GOOGLE_CLIENT_SECRET', 'secretRef', 'google-client-secret')), createArray()))]",
              "resources": {
                "cpu": "[json(parameters('containerCpu'))]",
                "memory": "[parameters('containerMemory')]"
              }
            },
            {
              "name": "redis",
              "image": "redis:7-alpine",
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]"
          }
        }
      },
