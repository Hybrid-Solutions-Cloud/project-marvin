          "subjectPrefix": "GOOGLE: "
        },
        {
          "calendarId": "family_google",
          "visibility": "default",
          "detailMode": "full",
          "subjectPrefix": "GOOGLE: ",
          "copyLocation": true,
          "copyDescription": true
        },
        {
          "calendarId": "personal_apple",
          "visibility": "private",
          "detailMode": "subject",
          "subjectPrefix": "GOOGLE: "
        }
      ]
    },
    {
      "source": "family_google",
      "targets": [
        {
          "calendarId": "work_m365",
          "visibility": "private",
          "detailMode": "subject",
          "subjectPrefix": "FAMILY: "
        },
        {
          "calendarId": "contract_m365",
          "visibility": "private",
          "detailMode": "subject",
