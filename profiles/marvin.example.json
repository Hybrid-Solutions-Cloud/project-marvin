          "subjectPrefix": "CONTRACT: ",
          "copyLocation": true,
          "copyDescription": true
        },
        {
          "calendarId": "personal_apple",
          "visibility": "private",
          "detailMode": "subject",
          "subjectPrefix": "CONTRACT: "
        }
      ]
    },
    {
      "source": "personal_google",
      "targets": [
        {
          "calendarId": "work_m365",
          "visibility": "private",
          "detailMode": "subject",
          "subjectPrefix": "GOOGLE: "
        },
        {
          "calendarId": "contract_m365",
          "visibility": "private",
