{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hybrid-solutions-cloud.github.io/project-marvin/schema/marvin-profile.json",
  "title": "Project Marvin Profile",
  "type": "object",
  "required": ["name", "timezone", "syncWindowDays", "privacyDefaults", "calendars", "routes"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "timezone": { "type": "string", "minLength": 1 },
    "syncWindowDays": { "type": "integer", "minimum": 1 },
    "privacyDefaults": {
      "type": "object",
      "required": ["mirrorMode", "visibility"],
      "properties": {
        "mirrorMode": { "type": "string", "enum": ["busy", "subject"] },
        "visibility": { "type": "string", "enum": ["private"] }
      }
    },
    "calendars": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "label", "provider", "email"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "enum": ["m365", "outlook", "google", "apple-caldav"] },
          "email": { "type": "string", "minLength": 3 },
          "optional": { "type": "boolean" }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "targets", "mirrorMode", "subjectPrefix"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "targets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "mirrorMode": { "type": "string", "enum": ["busy", "subject"] },
          "subjectPrefix": { "type": "string" }
        }
      }
    }
  }
}
